# Senha compartilhada para entrar no quadro (defina o que quiser).
BOARD_PASSWORD=troque-esta-senha

# String aleatória usada para assinar o cookie de sessão. Gere uma, por
# exemplo: openssl rand -hex 32
AUTH_SECRET=troque-por-uma-string-aleatoria-longa

# A variável abaixo NÃO precisa ser criada manualmente: ela aparece sozinha
# quando você conecta um banco Postgres (ex.: Supabase) na aba Storage do
# projeto na Vercel.
# POSTGRES_URL=
